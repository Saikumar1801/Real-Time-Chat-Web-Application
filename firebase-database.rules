rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User data rules
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;

      // Rule for the user's list of rooms
      match /rooms/{roomId} {
        allow read: if request.auth.uid == userId;
        // Allow CREATE if the requesting user is a participant in the new room data
        allow create: if request.auth.uid in request.resource.data.participantIds;
        // Allow DELETE only by the user themselves (for leaving a room)
        allow delete: if request.auth.uid == userId;
      }
    }

    // Chat room rules
    match /chatrooms/{roomId} {
      allow read: if request.auth.uid in resource.data.participantIds;
      allow create: if request.auth.uid == request.resource.data.createdBy &&
                       request.auth.uid in request.resource.data.participantIds;
      allow update: if isAdmin(roomId);
      allow delete: if isAdmin(roomId);

      // Members subcollection
      match /members/{userId} {
        allow read: if request.auth.uid in get(/databases/$(database)/documents/chatrooms/$(roomId)).data.participantIds;
        allow create: if isAdmin(roomId) || request.auth.uid == userId; // Allow self-add during private chat creation
        allow update: if isAdmin(roomId);
        allow delete: if isAdmin(roomId) || request.auth.uid == userId;
      }

      // Message rules
      match /messages/{messageId} {
        allow read: if request.auth.uid in get(/databases/$(database)/documents/chatrooms/$(roomId)).data.participantIds;
        allow create: if (request.auth.uid in get(/databases/$(database)/documents/chatrooms/$(roomId)).data.participantIds) && 
                       request.auth.uid == request.resource.data.senderId;
        allow update: if request.auth.uid == resource.data.senderId;
        allow delete: if request.auth.uid == resource.data.senderId || isAdmin(roomId);
      }
    }

    // Other collection rules
    match /mutes/{userId}/{path=**} {
      allow read, write: if request.auth.uid == userId;
    }

    match /joinRequests/{requestId} {
      allow create: if request.auth != null;
      allow read: if request.auth.uid == resource.data.userId || request.auth.uid == resource.data.adminId;
      allow update: if request.auth.uid == resource.data.adminId;
      allow delete: if false;
    }

    match /presence/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    match /typing/{roomId}/{userId} {
      allow read: if request.auth.uid in get(/databases/$(database)/documents/chatrooms/$(roomId)).data.participantIds;
      allow write: if request.auth.uid == userId;
    }

    match /pinnedRooms/{userId}/{roomId} {
      allow read, write: if request.auth.uid == userId;
    }

    // Helper function
    function isAdmin(roomId) {
      return get(/databases/$(database)/documents/chatrooms/$(roomId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    // 🔒 Global fallback rule (must be last)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
